# Log level for runtime actions: debug, info, warn or error
LOG_LEVEL=info

# Field definitions as JSON (see docs/fields.md). Leave empty to use the fields managed on the Admin page.
CHECKOUT_FIELDS=

# Optional. The webhook public key from Stores > Configuration > Adobe Services > Webhooks
# (Digital Signature Configuration). When set, the validate-order webhook rejects unsigned requests.
# Paste the PEM on one line or with \n line breaks.
COMMERCE_WEBHOOKS_PUBLIC_KEY=
